# —— MiMo（小米，OpenAI 兼容接口）——
# LLM / STT / TTS 都走这一个 key + base_url（把下面换成你自己的）
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# —— LLM（DSH 语音桥，可切换回 OpenAI 兼容接口）——
LLM_PROVIDER=dsh
# DSH 桌面端 Web 端口每次启动随机变化；由插件运行时管理器拉起的 worker 会自动
# 注入当前端口，这里只是手动跑 worker 时的兜底（填你当前 DSH 的 host 端口）。
DSH_VOICE_URL=http://127.0.0.1:3081
# 与 dsh-voice-bridge 的 cordis.patch.yml 里 config.token 保持一致（任意随机串）
DSH_VOICE_TOKEN=replace-with-local-token
DSH_VOICE_CWD=F:\LiveKitVoice
# 仅 LLM_PROVIDER=openai 回退模式使用：任意 OpenAI 兼容端点
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash

# —— LiveKit 本地服务器（已部署在 F:/LiveKitVoice/livekit-server）——
# key/secret 必须与 livekit-server/config.yml 里的 keys 一致
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-livekit-api-secret
